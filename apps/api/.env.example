# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kdp_factory
# 32+ random bytes, base64 or hex. Used for encrypting provider API keys at rest.
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Jobs ---
REDIS_URL=redis://localhost:6379
# bullmq (default, requires Redis + `npm run dev:worker`) or inline (single-process dev/test)
JOB_RUNNER=bullmq

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3-compatible (STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- AI providers (optional; the mock provider works without keys) ---
# Server-level defaults; workspaces can store their own encrypted keys in Settings.
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
FAL_KEY=

# --- HTTP ---
PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
